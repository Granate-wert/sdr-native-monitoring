{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdr-native-monitoring.local/schemas/sdr_processing_policy_v1.schema.json",
  "title": "SDR host-processing REQUEST recipe1, not proof of native application",
  "$comment": "16KiB UTF-8 input limit and duplicate-key/type/control/surrogate guards are enforced by the domain parser before native admission. Canonical bytes: sorted keys, ASCII escapes, compact separators. Non-OFF modes need matching explicit native support; profile references do not prove applicable filtering. Outcome/RF validity and native memory reservation are separate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "dc_mode", "spur_mode", "spur_profile", "compare_raw"],
  "properties": {
    "schema": {"const": "sdr-processing-policy"},
    "schema_version": {"type": "integer", "const": 1},
    "dc_mode": {"enum": ["off", "block_mean_v1"]},
    "spur_mode": {"enum": ["off", "candidates_v1", "profile_notch_v1"]},
    "compare_raw": {"type": "boolean"},
    "spur_profile": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/profile"}]}
  },
  "allOf": [
    {
      "if": {"properties": {"spur_mode": {"const": "off"}}},
      "then": {"properties": {"spur_profile": {"type": "null"}}},
      "else": {"properties": {"spur_profile": {"$ref": "#/$defs/profile"}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "revision", "digest", "applicability_digest"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "revision": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "digest": {"$ref": "#/$defs/digest"},
        "applicability_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
